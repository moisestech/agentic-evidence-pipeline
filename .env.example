# Environment
DATABASE_URL="postgresql://aep:aep@localhost:5433/aep?schema=public"

# Offline demo and CI unit checks require no provider credential.
# Live eval is opt-in only. The graph still uses the deterministic fake provider
# until a ModelProvider adapter is wired. Do not claim Claude or OpenAI deploys
# until MODEL_PROVIDER is implemented and verified.

MODEL_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aep
UPLOAD_STORAGE_URL=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# TRIGGER_SECRET_KEY=   # optional; only needed to deploy Trigger.dev tasks
# AEP_LIVE_EVAL=        # set to 1 only for the opt-in live harness
