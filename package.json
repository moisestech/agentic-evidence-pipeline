{
  "name": "agentic-evidence-pipeline",
  "private": true,
  "version": "0.0.1",
  "description": "Production-style TypeScript pipeline for evidence collection, hybrid retrieval, typed agent decisions, human approval, and replayable audit trails.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "bun scripts/bootstrap.ts",
    "doctor": "bun scripts/doctor.ts",
    "demo": "bun scripts/demo.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "eval:offline": "bun scripts/eval-offline.ts",
    "eval:live": "bun scripts/eval-live.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "bun-types": "^1.2.16",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.2.16",
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT"
}
